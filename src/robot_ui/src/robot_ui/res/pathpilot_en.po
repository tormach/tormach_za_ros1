msgid "msg_update_frame_from_current_position_text"
msgstr "Update Frame From Current Position"

msgid "msg_update_frame_from_current_position_tooltip"
msgstr "This will update the frame based on the current position of the robot."

msgid "msg_update_frame_using_wizard_text"
msgstr "Update Frame Using Wizard"

msgid "msg_update_frame_using_wizard_tooltip"
msgstr "This will enable you to update the frame using the Wizard. The Wizard guides a user through 3 and 4-methods that can be used to configure a frame.  For more information (and a video) click on the "discuss online" icon on this tooltip."

msgid "msg_user_frames_tab_text"
