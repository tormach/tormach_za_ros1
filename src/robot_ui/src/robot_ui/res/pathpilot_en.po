msgid "msg_add_pp_cnc_instance_text"
msgstr "Add"

msgid "msg_add_pp_cnc_instance_tooltip"
msgstr "Add a PathPilot CNC machine instance.  If the Tormach robot is on the same local area network as a PathPilot/Tormach CNC machine, that machine will show up on the list of available instances.  Select the desired instance and click "Add".  You will be able to name this instance.  Multiple PathPilot machines may be selected.  For more information, see https://tormach.atlassian.net/wiki/spaces/ROBO/pages/1930690719/Tormach+Robot+Programming+Language#TormachRobotProgrammingLanguage-PathPilotRemote"

msgid "msg_remove_pp_cnc_instance_text"
msgstr "Remove"

msgid "msg_remove_pp_cnc_instance_tooltip"
msgstr "Remove a PathPilot CNC machine instance."

msgid "msg_zero_all_joints_text"
msgstr "Zero All Joints"

msgid "msg_zero_all_joints_tooltip"
msgstr "This button is used for mastering the robot and should not be used unless the robot needs to be remastered.  ZA6 robots are mastered at the factory and this button should not be used in normal robot operation."

msgid "msg_power_off_text"
msgstr "Power Off"

msgid "msg_power_off_tooltip"
msgstr "Removes power from drives and applies brakes to joints.  "

msgid "msg_enable_preview_text"
msgstr "Enable Preview"

msgid "msg_enable_preview_tooltip"
msgstr "Toggle the robot preview off and on. "

msgid "msg_create_from_default_text"
msgstr "Create From Default "

msgid "msg_create_from_default_tooltip"
msgstr "Creates a new RViz Config file with default settings in the user directory for preview customization."

msgid "msg_edit_in_rviz_text"
msgstr "Edit In Rviz"

msgid "msg_edit_in_rviz_tooltip"
msgstr "Opens the RViz Preview config file in RViz for configuration by the user."

msgid "msg_rviz_config_name_input_text"
msgstr "Rviz Config Name Input"

msgid "msg_rviz_config_name_input_tooltip"
msgstr "File path of the custom rviz config file, leave empty to use the default (no customization)."

msgid "msg_code_editor_name_inpute_text"
msgstr "Code Editor Name Input"

msgid "msg_code_editor_name_inpute_tooltip"
msgstr "Override the default code editor when "Edit Program" is selected. Editor must already be installed on controller."

msgid "msg_probe_setting_toggle_text"
msgstr "Probe Setting Active/Passive toggle"

msgid "msg_probe_setting_toggle_tooltip"
msgstr "Digital input #1 is reserved for a touch probe (for more information on probing commands, see documentation here: https://tormach.atlassian.net/wiki/spaces/ROBO/pages/1930690719/Tormach+Robot+Programming+Language#TormachRobotProgrammingLanguage-Probing).  Probes may either be "active" - probe is normally outputing 24V, grounded when triggered, or "passive" - probe is normally outputting 0 volts, 24V when triggered.  This setting allows the user to choose which type of probe is connected to input 1.  If no probe is connected, leave this setting to "active""

msgid "msg_enable_main_loop_warning_text"
msgstr "Enable Main Loop Warning"

msgid "msg_enable_main_loop_warning_tooltip"
msgstr "Toggles the warning when you try to run a program that will run infinitely or until the program is interrupted."

msgid "msg_reload_text"
msgstr "Reload"

msgid "msg_reload_tooltip"
msgstr "Force the robot program interpretter to reload. This can be useful if dependencies are not updating automatically for your actively loaded robot program."

msgid "msg_tools_hal_scope_text"
msgstr "HAL Scope "

msgid "msg_tools_hal_scope_tooltip"
msgstr "HAL Scope is a digital software oscilloscope that can monitor (over time) any signals or pins available in the robot's hardware abstraction layer."

msgid "msg_tools_hal_meter_text"
msgstr "HAL Meter"

msgid "msg_tools_hal_meter_tooltip"
msgstr "HAL Meter is a digital software multimeter that can inspect the current value of any pin or signal available in the robot's hardware abstraction layer."

msgid "msg_tools_rviz_text"
msgstr "Rviz"

msgid "msg_tools_rviz_tooltip"
msgstr ""

msgid "msg_tools_rqt_gui_text"
msgstr "RQT GUI"

msgid "msg_tools_rqt_gui_tooltip"
msgstr ""

msgid "msg_new_waypoint_from_current_position_text"
msgstr "New Waypoint From Current Position"

msgid "msg_new_waypoint_from_current_position_tooltip"
msgstr "Creates a new waypoint based on the current position of the robot.  User will have the choice of creating this waypoint as a "joints" type (recording of the current joint angles) or "pose" type (recording of the robot's tool control point cartesian positions.  User also can create the waypoint as "global" (accessible all the time) or "program" (defined within the currently loaded robot program)."

msgid "msg_hold_to_move_to_marker_text"
msgstr "Hold To Move To Marker "

msgid "msg_hold_to_move_to_marker_tooltip"
msgstr "The "marker" is the green sphere attached to the tool control point of the orange (target pose) robot on the Jog screen.  It represents the target cartesian pose for the robot, in both XYZ space and ABC rotations.  The marker can be moved by clicking and dragging with the mouse, or by entering XYZ/ABC values on the Marker Ops portion of the Jog screen.  When you click and hold this button the physical robot will move to the marker's target position."

msgid "msg_cartesian_jog_marker_ops"
msgstr "Cartesian Jog Marker OPS"

msgid "msg_cartesian_jog_marker_ops_tooltip"
msgstr "This button toggles between "Cartesian" and "Marker Operations" jogging controls.  Cartesian controls allow the user to click X, Y, Z, A, B, or C buttons to jog the robot in X, Y, or Z directions or A, B, or C rotations.  Jogging will be either incremental (at the currently selected step size) or continuous, depending on the Jog Step/Cont button setting.  The Marker Operations controls allow the user to position the marker (green sphere at the tool control point of the orange represenation of the robot's target pose).  The user is offered convenience buttons (Top, Back, Left, etc) that align the marker with the current user frame, and with digital read outs that accept target XYZABC positions.  When the marker is positioned to the user's satisfaction, the Hold to Move to Marker button can be used to move the physical robot to the target pose represented by the orange robot image on the Jog screen."

msgid "msg_left_text"
msgstr "Left"

msgid "msg_left_tooltip"
msgstr "The Left marker operation button will align the tool control point's Z axis with the Y axis of the current user frame.  With no tool or user frame active, the Left button moves the robot's tool flange to the "left of the marker" as observed by a user facing the robot."

msgid "msg_top_text"
msgstr "Top"

msgid "msg_top_tooltip"
msgstr "The Top marker operation button will align the tool contol point's Z axis with the Z axis of the current user frame.  With no tool frame or user frame active, this button will move the tool flange "on top of" the marker.  "

msgid "msg_bottom_text"
msgstr "Bottom"

msgid "msg_bottom_tooltip"
msgstr "The Bottom marker operation button will align the tool contol point's Z axis with the Z axis of the current user frame.  With no tool frame or user frame active, this button will move the tool flange "under" the marker, facing up.  "

msgid "msg_right_text"
msgstr "Right"

msgid "msg_right_tooltip"
msgstr "The Right marker operation button will align the tool control point's Z axis with the Y axis of the current user frame.  With no tool or user frame active, the Right button moves the robot's tool flange to the "right of the marker" as observed by a user facing the robot."

msgid "msg_front_text"
msgstr "Front"

msgid "msg_front_tooltip"
msgstr "The Front marker operation button aligns the tool control point's Z axis with the X axis of the current user frame.  With no tool or user frame active, the Front button moves the robots tool flange "in front of" the marker as observed by a user facing the robot."

msgid "msg_back_text"
msgstr "Back"

msgid "msg_back_tooltip"
msgstr "The Back marker operation button aligns the tool control point's Z axis with the X axis of the current user frame.  With no tool or user frame active, the Back button moves the robots tool flange "behind" or to the "back" of the marker as observed by a user facing the robot."

msgid "msg_basic_advanced_text"
msgstr "Toggle Marker Operations"

msgid "msg_basic_advanced_tooltip"
msgstr "The Basic/Advance marker operations button toggles between the basic (Left/Right/Front/Back/Top/Bottom) buttons and an advanced page that allows the user to move the marker to arbitrarily align tool frame and user frame axes."

msgid "msg_reset_text"
msgstr "Reset"

msgid "msg_reset_tooltip"
msgstr "Reset marker operations button will reset the marker to the last position it was in prior to using any other marker operation button."

msgid "msg_current_text"
msgstr "Current"

