<?xml version="1.0" ?>
<robot name="tormach_pcnc_1100" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find tormach_pcnc_1100_support)/urdf/tormach_pcnc_1100_macro.xacro"/>
  <xacro:include filename="$(find tormach_pcnc_1100_support)/urdf/tormach_pcnc_1100_additionals.xacro"/>
  <xacro:tormach_pcnc_1100_macro prefix="$(arg prefix)"/>
  <xacro:tormach_pcnc_1100_sump prefix="$(arg prefix)"/>
  <xacro:tormach_pcnc_1100_cover_right prefix="$(arg prefix)"/>

  <!-- 'world' frame: default pose reference frame -->
  <link name="world" />
  <joint name="world-$(arg prefix)frame" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="world"/>
    <child link="$(arg prefix)frame"/>
  </joint>
</robot>
