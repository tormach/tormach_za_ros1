<?xml version="1.0"?>
<launch>

  <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find tormach_pcnc_1100_support)/urdf/tormach_pcnc_1100.xacro'" />
  <arg name="gui" default="True" />

  <param name="use_gui" value="$(arg gui)" />

  <node name="joint_state_publisher" pkg="joint_state_publisher"
type="joint_state_publisher" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
type="state_publisher" />

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tormach_pcnc_1100_support)/urdf/tormach_pcnc_1100_support.rviz"/>

</launch>
