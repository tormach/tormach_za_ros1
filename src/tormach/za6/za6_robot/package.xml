<?xml version="1.0"?>
<package format="2">

  <name>za6_robot</name>
  <version>0.3.0</version>
  <description>
    Wraps the za6_moveit_config package generated by
    moveit_setup_assistant in order to override settings without
    touching the base package and breaking future assistant runs
  </description>
  <author email="john@dovetail-automata.com">John Morris</author>
  <maintainer email="john@dovetail-automata.com">John Morris</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Needed by moveit, but not pulled in for some reason -->
  <build_depend>srdfdom</build_depend>

  <!-- Local deps -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>za6_moveit_config</exec_depend>
  <exec_depend>za6_description</exec_depend>
  <exec_depend>za6_hardware</exec_depend>
  <exec_depend>za6_tools</exec_depend>
  <exec_depend>robot_command</exec_depend>
  <exec_depend>cartesian_state</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_frame</exec_depend>
  <exec_depend>robot_ui</exec_depend>
  <exec_depend>robot_scene</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros_machinetalk</exec_depend>
  <exec_depend>redis_store</exec_depend>
  <exec_depend>za6_manipulator_ikfast_plugin</exec_depend>
  <exec_depend>bio_ik</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- jogging -->
  <exec_depend>joy</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>movej_ik_server</exec_depend>
  <exec_depend>ydlidar_ros_driver</exec_depend>
  <exec_depend>lidar_pointcloud_processor</exec_depend>
  <exec_depend>robot_machine_watchdog</exec_depend>
  <exec_depend>workpiece_visualizer</exec_depend>
  <exec_depend>robot_jog</exec_depend>
  <exec_depend>spacenav_node</exec_depend>
  <exec_depend>se_jogger</exec_depend>
  <!-- Should be pulled in from base za6_moveit_config package -->
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>interruptible_joint_trajectory_controller</exec_depend>

  <!-- Pull in rqt plugins for development here -->
  <exec_depend>rqt_common_plugins</exec_depend>
  <exec_depend>rqt_robot_plugins</exec_depend>

  <!-- dependencies to Tormach mill URDFs -->
  <exec_depend>tormach_pcnc_1100_support</exec_depend>

</package>
