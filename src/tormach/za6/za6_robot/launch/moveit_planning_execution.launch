<?xml version="1.0"?>
<launch>
  <!-- The planning and execution components of MoveIt! configured to run -->
  <!-- using the ROS-Industrial interface. -->

  <!-- ++++++++++++++++++++++++++++++ PUBLIC INTERFACE ++++++++++++++++++++++++++++++ -->
  <!-- Sim mode -->
  <arg name="sim" default="$(eval optenv('HARDWARE_MODE', 'sim') == 'sim')"/>
  <!-- HAL debug output -->
  <!-- - Output HAL debug messages to screen (console) -->
  <arg name="hal_debug_output" doc="Print MK-HAL debug messages to the console" />
  <!-- - Set HAL debug level, 0-5 -->
  <arg name="hal_debug_level" doc="MK-HAL debug level limiter (0-5)" />
  <arg name="tool" doc="Connected tool to the robot flange" />
  <arg name="mastering" doc="Overload settings with mastering values" />
  <!-- set a global wait timeout for services and actions -->
  <arg name="ros_wait_timeout_s" doc="Timeout for service and instances" />

  <!-- Arguments with passed value OPTIONAL -->
  <arg name="rviz" default="true" doc="Start RViz instance" />

  <!-- ++++++++++++++++++++++++++++++ END PUBLIC INTERFACE ++++++++++++++++++++++++++++++ -->

  <param name="sim" value="$(arg sim)" />

  <param name="ros_wait_timeout_s" value="$(arg ros_wait_timeout_s)"/>

  <!-- load the robot_description parameter before launching ROS-I nodes -->
  <include file="$(find za6_robot)/launch/planning_context.launch" >
    <arg name="load_robot_description" value="true" />
    <arg name="mastering" value="$(arg mastering)"/>
    <arg name="tool" value="$(arg tool)" />
  </include>

  <!-- load the parameter persistence server -->
  <include
      file="$(find za6_robot)/launch/parameter_persistence.launch"
      >
    <arg name="ros_wait_timeout_s" value="$(arg ros_wait_timeout_s)"/>
    <arg name="mastering" value="$(arg mastering)"/>
  </include>

  <!-- run the robot simulator and action interface nodes -->
  <group if="$(arg sim)">
    <!--<include file="$(find industrial_robot_simulator)/launch/robot_interface_simulator.launch" />-->
  </group>

  <!-- run the "real robot" interface nodes -->
  <!--   - this typically includes: robot_state, motion_interface, and joint_trajectory_action nodes -->
  <!--   - replace these calls with appropriate robot-specific calls or launch files -->
  <include file="$(find za6_hardware)/launch/hal_hardware.launch">
    <arg name="sim" value="$(arg sim)"/>
    <arg name="hal_debug_output" value="$(arg hal_debug_output)"/>
    <arg name="hal_debug_level" value="$(arg hal_debug_level)"/>
    <arg name="tool" value="$(arg tool)"/>
  </include>

  <!-- publish the robot state (tf transforms) -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="use_tf_static" type="bool" value="true"/>
  </node>

  <!-- Load ros_control configuration from ros_controllers.launch -->
  <include file="$(find za6_robot)/launch/ros_controllers.launch"/>

  <include file="$(find za6_robot)/launch/move_group.launch">
    <arg name="publish_monitored_planning_scene" value="true" />
    <arg name="mastering" value="$(arg mastering)"/>
    <arg name="tool" value="$(arg tool)"/>
  </include>

  <group if="$(arg rviz)">
    <include file="$(find za6_robot)/launch/moveit_rviz.launch">
      <arg name="config" value="true"/>
      <arg name="mastering" value="$(arg mastering)"/>
    </include>
  </group>

</launch>
