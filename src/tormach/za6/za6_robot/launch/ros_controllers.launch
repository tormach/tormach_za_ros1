<?xml version="1.0"?>
<launch>

  <!-- Override settings in
       ../../za6_moveit_config/launch/ros_controllers.launch;
       load additional controllers
  -->

  <!-- This loads ros_controllers.yaml, parts of which are overridden
       in overrides.launch and ../config/ros_controllers.yaml -->
  <include
      file="$(find za6_moveit_config)/launch/ros_controllers.launch"
      />

  <!-- ros_controllers.launch, generated by moveit_setup_assistant,
       doesn't launch the joint_state_controller, even though
       moveit_setup_assistant configures the controller. -->
  <node
      name="ros_control_controller_manager"
      pkg="controller_manager"
      type="controller_manager"
      respawn="false"
      output="screen"
      args="spawn joint_state_controller"
    />

</launch>
