<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="prototype_stand_macro" params="prefix">
    <!-- link list -->
    <link name="${prefix}stand_link">
      <visual>
        <geometry>
          <mesh filename="package://za6_description/meshes/stand-urdf-prototype.stl"/>
        </geometry>
        <origin rpy="0.0 0 0.0" xyz="0 0 0"/>
        <material name="DarkGray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://za6_description/meshes/stand-urdf-prototype.stl"/>
        </geometry>
        <origin rpy="0.0 0 0.0" xyz="0 0 0"/>
      </collision>
    </link>

    <!-- link the robot is going to be attached to -->
    <link name="${prefix}stand_flange" />

    <joint name="${prefix}stand_joint" type="fixed">
      <parent link="${prefix}stand_link"/>
      <child link="${prefix}stand_flange"/>
      <axis xyz="0 0 0"/>
      <origin rpy="0.0 0.0 -0.785398163" xyz="-0.1591 0.1591 0.70485"/>
    </joint>

  </xacro:macro>
</robot>
